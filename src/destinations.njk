---
layout: layouts/base.njk
title: "Destinations"
description: "Explore KD Holidayz's domestic and international destinations — spiritual, honeymoon, family, and adventure tours."
---
{% import "macros/cards.njk" as cards %}
{% import "partials/page-banner.njk" as banner with context %}

{{ banner.render([{"label":"Home","url":"/"},{"label":"Destinations"}], "🌏 Explore", "Our Destinations", 'From Himalayan pilgrimages to island honeymoons — browse KD Holidayz\'s curated destinations, or <a href="/custom-tour/" style="color:var(--color-gold-accent); font-weight:700;">build your own</a>.', "destinations") }}

<section class="container destinations__listing" style="margin-top:40px;">
  <div class="filter-chips" id="destFilters">
    <button class="filter-chip is-active" data-filter="all" type="button">All</button>
    <button class="filter-chip" data-filter="domestic" type="button">🇮🇳 Domestic</button>
    <button class="filter-chip" data-filter="international" type="button">✈️ International</button>
    <button class="filter-chip" data-filter="family" type="button">Family</button>
    <button class="filter-chip" data-filter="honeymoon" type="button">Honeymoon</button>
    <button class="filter-chip" data-filter="spiritual" type="button">Spiritual</button>
    <button class="filter-chip" data-filter="pilgrimage" type="button">🛕 Pilgrimage Yatra</button>
    <button class="filter-chip" data-filter="adventure" type="button">Adventure</button>
    <button class="filter-chip" data-filter="group" type="button">Group</button>
  </div>

  <div class="grid grid--3" id="destGrid">
    {% for item in collections.destinations %}
      {{ cards.destinationCard(item.data, item.url) }}
    {% endfor %}
  </div>
  <p class="text-muted" id="destEmpty" style="display:none; text-align:center; padding:48px 0;">No destinations match that filter yet — <a href="/custom-tour/" style="color:var(--color-primary); font-weight:700;">tell us what you have in mind</a>.</p>
</section>

<section class="container section destinations__cta">
  <div class="cta-band">
    <h2 style="color:var(--color-white);">Can't Find Your Dream Destination?</h2>
    <p style="max-width:520px; margin-inline:auto; margin-top:16px; opacity:0.85;">We specialize in building custom itineraries from scratch — tell us where you want to go and we'll design the plan.</p>
    <div style="margin-top:24px;">
      <a href="/custom-tour/" class="btn btn--primary">Customize My Trip 🎨</a>
    </div>
  </div>
</section>
