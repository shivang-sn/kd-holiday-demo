---
layout: layouts/base.njk
title: "Visa Disclaimer & Visa Assistance Terms"
description: "KD Holidayz visa disclaimer and visa assistance terms: scope of assistance, customer responsibilities and limitations."
---
{% import "partials/page-banner.njk" as banner with context %}
{% import "partials/icons.njk" as icon %}
{% set india = company.offices[0] %}
{% set kenya = company.offices[1] %}

{{ banner.render([{"label":"Home","url":"/"},{"label":"Visa Disclaimer"}], "🛂 Visa Assistance", "Visa Disclaimer & Assistance Terms", null, "visa-disclaimer") }}

<section class="privacy-v2">
  <div class="container">
    <div class="legal-meta text-muted">
      <span class="pill">Effective Date: 22 September 2026</span>
      <span class="pill">Last Updated: 22 September 2026</span>
    </div>

    <div class="privacy-v2__layout">
      <aside class="privacy-v2__sidebar">
        <div class="card privacy-v2__sidebar-card">
          <div class="privacy-v2__progress" aria-hidden="true"><div class="privacy-v2__progress-bar" id="pvProgressBar"></div></div>
          <div class="privacy-v2__meta text-muted">📖 29 sections · ~7 min read</div>
          <nav class="privacy-v2__nav" id="pvNav" aria-label="Visa disclaimer categories">
            <a href="#cat-role" data-cat="cat-role"><span class="privacy-v2__nav-icon">{{ icon.render("tag", 16) }}</span>Our Role &amp; Approval</a>
            <a href="#cat-responsibilities" data-cat="cat-responsibilities"><span class="privacy-v2__nav-icon">{{ icon.render("person", 16) }}</span>Your Responsibilities</a>
            <a href="#cat-process" data-cat="cat-process"><span class="privacy-v2__nav-icon">{{ icon.render("compass", 16) }}</span>Process &amp; Timing</a>
            <a href="#cat-fees" data-cat="cat-fees"><span class="privacy-v2__nav-icon">{{ icon.render("coin", 16) }}</span>Fees, Refusal &amp; Reapplication</a>
            <a href="#cat-documents" data-cat="cat-documents"><span class="privacy-v2__nav-icon">{{ icon.render("note", 16) }}</span>Documents &amp; Data Sharing</a>
            <a href="#cat-immigration" data-cat="cat-immigration"><span class="privacy-v2__nav-icon">{{ icon.render("globe", 16) }}</span>Travel &amp; Immigration Rules</a>
            <a href="#cat-legal" data-cat="cat-legal"><span class="privacy-v2__nav-icon">{{ icon.render("mail", 16) }}</span>Legal &amp; Contact</a>
          </nav>
          <div class="privacy-v2__actions">
            <button type="button" class="btn btn--ghost btn--sm" id="pvExpandAll">Expand All</button>
            <button type="button" class="btn btn--ghost btn--sm" id="pvCollapseAll">Collapse All</button>
          </div>
        </div>
      </aside>

      <div class="privacy-v2__main">
        <section class="privacy-v2__category" id="cat-role">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("tag", 20) }}</span>
            <h2>Our Role &amp; Approval</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item is-open">
              <button class="accordion__trigger" type="button" aria-expanded="true">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">1. Scope of Visa Assistance</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>KD Holidayz may provide visa assistance, documentation guidance, appointment coordination, document checking and submission support for selected destinations. Visa assistance is a facilitation service and does not constitute immigration advice, legal advice or a guarantee of visa approval.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">2. Final Decision Rests with Authorities</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>The decision to grant, refuse, delay, cancel or condition a visa rests solely with the relevant embassy, consulate, immigration authority, government department or authorised visa processing centre. KD Holidayz has no authority to influence or guarantee such decisions.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">3. No Guarantee of Visa Approval</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Payment of a visa service fee or submission of an application does not guarantee approval. A visa may be refused, delayed or granted for a shorter period or with different conditions than requested.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">22. Travel Agent / Facilitator Role</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Unless expressly stated otherwise, KD Holidayz acts as a travel consultant/facilitator assisting customers with the visa process. KD Holidayz is not an embassy, consulate, immigration authority or government agency.</p>
              </div></div>
            </div>
          </div>
        </section>

        <section class="privacy-v2__category" id="cat-responsibilities">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("person", 20) }}</span>
            <h2>Your Responsibilities</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">4. Customer Responsibility</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customers are responsible for providing complete, accurate and genuine information and documents. Customers must disclose previous visa refusals, immigration issues, travel history and other information where required by the relevant authority.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">5. Genuine Documents</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customers must provide genuine and valid documents. KD Holidayz will not knowingly submit forged, altered, misleading or fraudulent documents. If a customer provides inaccurate or fraudulent information, the application may be affected and KD Holidayz may discontinue assistance.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">6. Passport Validity</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customers are responsible for ensuring that their passport is valid for the required period and has sufficient blank pages where required. Passport requirements vary by destination and may change.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">23. Customer Review of Application</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customers should carefully review all application forms and supporting documents before submission. Once an application is submitted, changes may not be possible or may require additional charges.</p>
              </div></div>
            </div>
          </div>
        </section>

        <section class="privacy-v2__category" id="cat-process">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("compass", 20) }}</span>
            <h2>Process &amp; Timing</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">7. Visa Requirements Can Change</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Visa rules, fees, documentation requirements, processing times and eligibility criteria may change without prior notice. KD Holidayz will use reasonable efforts to communicate requirements available to it at the time of processing, but customers should also verify current requirements with the relevant authority.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">8. Processing Time</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Published or estimated processing times are not guaranteed. Processing may take longer due to additional scrutiny, document requests, interviews, security checks, high application volumes, holidays, government delays or other circumstances beyond KD Holidayz's control.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">9. Additional Documents and Interviews</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>The relevant authority may request additional documents, biometrics, interviews, medical examinations, police certificates or other information. Customers are responsible for providing such requirements within the specified deadline.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">20. Emergency or Expedited Processing</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Where an expedited or priority service is available, it is subject to the relevant authority or service provider. Payment for an expedited service does not guarantee visa approval or a particular decision date.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">21. Visa Appointment Services</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Appointment availability is controlled by the relevant embassy, consulate or visa centre. KD Holidayz cannot guarantee a particular appointment date or time unless confirmed by the relevant authority.</p>
              </div></div>
            </div>
          </div>
        </section>

        <section class="privacy-v2__category" id="cat-fees">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("coin", 20) }}</span>
            <h2>Fees, Refusal &amp; Reapplication</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">10. Visa Fees and Service Fees</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Government/embassy/consulate fees, visa centre charges, courier fees, biometric charges and KD Holidayz service fees are separate where applicable. Third-party and government fees may be non-refundable once paid or processing has commenced.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">11. Refusal or Rejection</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>If an application is refused or rejected, KD Holidayz is not responsible for the decision. Refunds, if any, will be governed by the applicable fee and refund terms. Government or visa-centre fees are generally subject to the relevant authority's rules.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">12. Reapplication</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>If a visa is refused, customers may choose to reapply where permitted. A new application may require new fees, documents and processing. KD Holidayz does not guarantee a different outcome on a subsequent application.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">24. Cancellation of Visa Assistance</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Cancellation of visa assistance is subject to the applicable service terms. Government, embassy, visa-centre, courier and third-party charges already incurred may not be refundable.</p>
              </div></div>
            </div>
          </div>
        </section>

        <section class="privacy-v2__category" id="cat-documents">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("note", 20) }}</span>
            <h2>Documents &amp; Data Sharing</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">13. Passport Handling</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Where a passport is provided to KD Holidayz or an authorised visa service partner, reasonable care will be taken to facilitate the requested process. Customers should not send original documents unless required for the service. KD Holidayz is not responsible for delays or loss caused by third-party courier, embassy, consulate or visa-centre processes, subject to applicable law.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">14. Data and Document Sharing</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Visa processing may require personal information and documents to be shared with embassies, consulates, immigration authorities, visa application centres, authorised agents and overseas service providers. Such information will be handled in accordance with the KD Holidayz <a href="/privacy-policy/">Privacy Policy</a> and applicable law.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">25. Communication of Visa Updates</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>KD Holidayz may communicate visa updates through email, phone or WhatsApp. Customers should provide an active contact number and email address and respond promptly to requests for additional documents or information.</p>
              </div></div>
            </div>
          </div>
        </section>

        <section class="privacy-v2__category" id="cat-immigration">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("globe", 20) }}</span>
            <h2>Travel &amp; Immigration Rules</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">15. Immigration and Entry Requirements</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>A visa does not automatically guarantee entry into a country. Border and immigration officials may make the final decision at the port of entry. Travellers must satisfy all entry, health, customs, immigration and other requirements.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">16. Transit Visas</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customers are responsible for checking transit visa requirements for every transit point in their itinerary. Requirements can depend on nationality, passport, airport, terminal, airline, itinerary and immigration rules.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">17. Visa Validity and Stay Period</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customers must check the visa validity, number of entries and permitted duration of stay before travelling. A visa holder must comply with the conditions attached to the visa.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">18. Overstay and Immigration Violations</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>KD Holidayz is not responsible for consequences arising from overstaying a visa, violating visa conditions, providing incorrect information to immigration authorities or failing to comply with local laws.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">19. Travel Before Visa Issuance</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Customers should not make irreversible travel commitments based solely on an expectation that a visa will be approved unless they accept the financial risk. KD Holidayz is not responsible for losses resulting from travel arrangements made before visa issuance.</p>
              </div></div>
            </div>
          </div>
        </section>

        <section class="privacy-v2__category" id="cat-legal">
          <div class="privacy-v2__category-head">
            <span class="privacy-v2__category-icon">{{ icon.render("mail", 20) }}</span>
            <h2>Legal &amp; Contact</h2>
          </div>
          <div class="accordion accordion--legal">
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">26. No Legal or Immigration Advice</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>Information provided by KD Holidayz is intended for travel and visa-processing assistance. It should not be treated as legal advice or a guarantee of eligibility. Customers requiring legal immigration advice should consult a qualified immigration lawyer or authorised professional.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">27. Limitation of Responsibility</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>KD Holidayz will make reasonable efforts to assist with visa processing, but cannot control government decisions, processing times, appointment availability or policy changes. Nothing in this disclaimer excludes rights or liabilities that cannot lawfully be excluded.</p>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">28. Contact Details</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>KD Holidayz, Registered Proprietorship</p>
                <div class="legal-offices">
                  <div class="legal-office">
                    <span class="pill office-card__label">India</span>
                    <div class="office-card__row"><span class="text-muted">{{ icon.render("pin", 18) }}</span><span>{{ india.address }}</span></div>
                    {% for phone in india.phones %}<div class="office-card__row"><span class="text-muted">{{ icon.render("phone", 18) }}</span><a href="{{ phone | telLink }}">{{ phone }}</a></div>{% endfor %}
                    <div class="office-card__row"><span class="text-muted">{{ icon.render("mail", 18) }}</span><a href="mailto:{{ india.email }}">{{ india.email }}</a></div>
                  </div>
                  <div class="legal-office">
                    <span class="pill office-card__label">Kenya Branch</span>
                    <div class="office-card__row"><span class="text-muted">{{ icon.render("pin", 18) }}</span><span>{{ kenya.address }}</span></div>
                    {% for phone in kenya.phones %}<div class="office-card__row"><span class="text-muted">{{ icon.render("phone", 18) }}</span><a href="{{ phone | telLink }}">{{ phone }}</a></div>{% endfor %}
                    <div class="office-card__row"><span class="text-muted">{{ icon.render("mail", 18) }}</span><a href="mailto:{{ kenya.email }}">{{ kenya.email }}</a></div>
                  </div>
                </div>
              </div></div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span class="accordion__badge"><span class="accordion__icon" aria-hidden="true"></span></span>
                <span class="accordion__question">29. Acknowledgement</span>
              </button>
              <div class="accordion__panel"><div class="accordion__panel-inner">
                <p>By requesting visa assistance from KD Holidayz, the customer acknowledges that visa decisions are made by the relevant government or immigration authority and that KD Holidayz cannot guarantee approval, processing time, appointment availability or entry into the destination country.</p>
              </div></div>
            </div>
          </div>
        </section>

        <p class="text-muted" style="text-align:center; margin-top:var(--space-6);">© 2026 KD Holidayz. All Rights Reserved.</p>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var progressBar = document.getElementById("pvProgressBar");
  if (progressBar) {
    var onScroll = function () {
      var el = document.documentElement;
      var scrollTop = el.scrollTop || document.body.scrollTop;
      var height = el.scrollHeight - el.clientHeight;
      var pct = height > 0 ? (scrollTop / height) * 100 : 0;
      progressBar.style.width = pct + "%";
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  var navLinks = document.querySelectorAll("#pvNav a");
  var categories = document.querySelectorAll(".privacy-v2__category");
  if (categories.length && navLinks.length && "IntersectionObserver" in window) {
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        navLinks.forEach(function (l) { l.classList.remove("is-active"); });
        var link = document.querySelector('#pvNav a[data-cat="' + entry.target.id + '"]');
        if (link) link.classList.add("is-active");
      });
    }, { rootMargin: "-15% 0px -70% 0px", threshold: 0 });
    categories.forEach(function (c) { obs.observe(c); });
  }

  var expandBtn = document.getElementById("pvExpandAll");
  var collapseBtn = document.getElementById("pvCollapseAll");
  function setAll(open) {
    document.querySelectorAll(".privacy-v2 .accordion__item").forEach(function (item) {
      item.classList.toggle("is-open", open);
      var trigger = item.querySelector(".accordion__trigger");
      if (trigger) trigger.setAttribute("aria-expanded", String(open));
    });
  }
  if (expandBtn) expandBtn.addEventListener("click", function () { setAll(true); });
  if (collapseBtn) collapseBtn.addEventListener("click", function () { setAll(false); });
})();
</script>
