---
layout: layouts/base.njk
title: "Custom Tour & Packages"
description: "Design your own journey with KD Holidayz — fully customized itineraries built around your budget, dates, and preferences."
---
{% import "macros/cards.njk" as cards %}
{% import "macros/forms.njk" as forms %}
{% import "partials/page-banner.njk" as banner %}

{{ banner.render([{"label":"Home","url":"/"},{"label":"Custom Tour & Packages"}], "🎨 Build Your Own Trip", "Design Your Own Journey", "Tell us your destination, dates, and budget — we'll design an itinerary around it, not the other way round.", "custom-tour") }}

<section class="section section--alt custom-tour__form">
  <div class="container" style="max-width:720px;">
    <form class="card" style="padding:40px;" id="customTourForm" novalidate>
      <div class="form-grid">
        {{ forms.tourInquiryFields("ct", collections.destinations, offers) }}
        {% if formConfig.recaptchaSiteKey %}
        <div class="form-field form-field--full g-recaptcha-container">
          <div id="recaptchaCustomTour"></div>
        </div>
        {% endif %}
      </div>
      <button type="submit" class="btn btn--primary btn--block" style="margin-top:24px;">Submit Custom Request 🚀</button>
    </form>
  </div>
</section>

<section class="section custom-tour__themes">
  <div class="container">
    <div class="section-heading section-heading--center">
      <div class="eyebrow" style="justify-content:center;">🎯 Popular Themes</div>
      <h2>Build Around What You're Celebrating</h2>
    </div>
    <div class="grid grid--4">
      {% for cat in tourCategories %}
        {{ cards.categoryTile(cat, collections.destinations | tagCount(cat.tag)) }}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt custom-tour__packages">
  <div class="container">
    <div class="section-heading">
      <div class="eyebrow">✨ We Build Anything</div>
      <h2>Specialized Packages We've Delivered</h2>
    </div>
    <div class="grid grid--2">
      {% for offer in offers %}
        {% if offer.title == "Canton Fair Sourcing Tour" or offer.title == "Rishikesh Wellness Retreat" %}
          {{ cards.offerCard(offer) }}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section custom-tour__cta">
  <div class="container">
    <div class="cta-band">
      <h2 style="color:var(--color-white);">Prefer to Just Chat It Through?</h2>
      <p style="max-width:480px; margin-inline:auto; margin-top:16px; opacity:0.85;">Message us directly on WhatsApp for a fast, no-obligation quote.</p>
      <div style="margin-top:24px;">
        <a href="{{ company.whatsappNumber | whatsappLink('Hi KD Holidayz, I would like a custom tour quote.') }}" class="btn btn--primary" target="_blank" rel="noopener">💬 Chat on WhatsApp</a>
      </div>
    </div>
  </div>
</section>
